# templates/vmagent_config.yaml.j2
global:
  scrape_interval: 30s
scrape_configs:
  - job_name: 'node'
    static_configs:
      - targets: ['localhost:{{ node_exporter_port }}']
{% if inventory_hostname in groups['mtproxymax_hosts'] | default([]) %}
  - job_name: 'mtproxymax'
    static_configs:
      - targets: ['localhost:{{ mtproxymax_metrics_port }}']
{% endif %}
